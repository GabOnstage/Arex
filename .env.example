# Discord Bot Configuration (Required)
DISCORD_TOKEN=your_bot_token_here
APPLICATION_ID=your_application_id_here
# Command prefix — keep it short (1-10 chars), e.g. ! or ? or arex!
# Do NOT paste shell paths here (e.g. Termux $PREFIX expands to /data/data/com.termux/files/usr)
COMMAND=!
OWNERS=123456789012345678,987654321098765432
ALLOWED_USER_IDS=123456789012345678

# Optional API Keys (Leave blank or fill if using these features)
NASA_API_KEY=DEMO_KEY
jeyy_api=your_jeyy_api_key_here
ROTECTOR_API_KEY=your_rotector_api_key_here
